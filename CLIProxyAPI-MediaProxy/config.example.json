{
  "listen": "127.0.0.1:8320",
  "auth_dir": "E:/U_App/CLIProxyAPI_work/CLIProxyAPI/storage/auth",
  "auth_providers": [
    {
      "provider": "agnes",
      "headers": {
        "Content-Type": "application/json"
      },
      "model_rules": [
        {
          "match_contains": "image",
          "type": "image",
          "endpoint": "/images/generations",
          "method": "POST",
          "request_format": "agnes-image",
          "response_format": "url",
          "default_size": "1024x768"
        },
        {
          "match_contains": "video",
          "type": "video",
          "endpoint": "/videos",
          "retrieve_endpoint": "{origin}/agnesapi?video_id={video_id}&model_name={model}",
          "method": "POST",
          "request_format": "agnes-video",
          "response_format": "auto",
          "default_width": 1280,
          "default_height": 704,
          "default_num_frames": 121,
          "default_frame_rate": 24,
          "poll_interval_ms": 3000,
          "poll_timeout_seconds": 180
        }
      ]
    },
    {
      "provider": "grok2api",
      "headers": {
        "Content-Type": "application/json"
      },
      "model_rules": [
        {
          "match_contains": "image-edit",
          "type": "image",
          "endpoint": "/images/edits",
          "method": "POST",
          "request_format": "openai-image",
          "response_format": "url"
        },
        {
          "match_contains": "image",
          "type": "image",
          "endpoint": "/images/generations",
          "method": "POST",
          "request_format": "openai-image",
          "response_format": "url"
        },
        {
          "match_contains": "video",
          "type": "video",
          "endpoint": "/videos/generations",
          "retrieve_endpoint": "{base_url}/videos/{request_id}",
          "method": "POST",
          "request_format": "openai-video",
          "response_format": "auto",
          "poll_interval_ms": 3000,
          "poll_timeout_seconds": 45
        }
      ]
    }
  ],
  "providers": []
}
