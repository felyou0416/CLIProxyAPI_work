# 同级代理项目（默认与面板同在 CLIProxyAPI_work 下）
CLIPROXYAPI_ROOT=E:\U_App\CLIProxyAPI_work\CLIProxyAPI

# 唯一可变数据目录：认证、模型、运行态配置、日志和备份
# CLIPROXYAPI_STORAGE_DIR=E:\U_App\CLIProxyAPI_work\CLIProxyAPI\storage

# RELAYX_CLI_BINARY=E:\U_App\CLIProxyAPI_work\CLIProxyAPI\CLIProxyAPI\bin\cli-proxy-api.exe

# CLIPROXYAPI_DASHBOARD_HOST=127.0.0.1
# CLIPROXYAPI_DASHBOARD_PORT=8765

# Cloudflared Tunnel 启动密钥
CLOUDFLARED_TUNNEL_TOKEN=your_cloudflared_tunnel_token_here
